# Build output
/target

# Scratch: edit scripts are written to a file, run, and thrown away
.*.py
.msg_*
# The line above is a pattern and nothing else: git takes everything after a pattern literally, so a
# comment on the same line becomes part of it and the rule silently matches nothing. Measured with
# `git check-ignore -v`, which is the only way to know an ignore rule works.

# Editor and tool scratch
*.rs.bk
*.swp
.idea/
.vscode/
.pi-codebase.json

# Artefacts the tests write
/tests/fixtures/out/
*.exe
*.o
*.obj
*.lib
*.pdb
*.ilk

# OS noise
Thumbs.db
desktop.ini
.DS_Store

